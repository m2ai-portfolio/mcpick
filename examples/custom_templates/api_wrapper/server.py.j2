@app.call_tool()
async def call_tool(name: str, arguments: Any) -> list[TextContent]:
    """Handle tool execution requests."""
    logger.info(f"Tool called: {name} with arguments: {arguments}")

    try:
{% for tool in tools %}
        {% if loop.first %}if{% else %}elif{% endif %} name == "{{ tool.name }}":
            result = await {{ tool.name }}(
{% for param in tool.parameters %}
                {{ param.name }}=arguments.get("{{ param.name }}"{% if not param.required %}, {% if param.default is not none %}{{ param.default | tojson }}{% else %}None{% endif %}{% endif %}){% if not loop.last %},{% endif %}

{% endfor %}
            )
{% endfor %}
        else:
            raise ValueError(f"Unknown tool: {name}")

        # Return result as JSON string
        return [TextContent(type="text", text=json.dumps(result, indent=2))]

    except Exception as e:
        logger.error(f"Error executing tool {name}: {e}", exc_info=True)
        error_response = {
            "status": "error",
            "error": str(e),
            "tool": name
        }
        return [TextContent(type="text", text=json.dumps(error_response, indent=2))]


async def main():
    """Run the MCP server."""
    logger.info("Starting {{ server_name }} MCP server with API wrapper")
    logger.info(f"API Base URL: {API_BASE_URL}")
    logger.info("Available tools: {% for tool in tools %}{{ tool.name }}{% if not loop.last %}, {% endif %}{% endfor %}")

    try:
        async with stdio_server() as (read_stream, write_stream):
            await app.run(
                read_stream,
                write_stream,
                app.create_initialization_options()
            )
    except Exception as e:
        logger.error(f"Server error: {e}", exc_info=True)
        raise


if __name__ == "__main__":
    asyncio.run(main())
