    """List available MCP tools."""
    return [
{% for tool in tools %}
        Tool(
            name="{{ tool.name }}",
            description="{{ tool.description }}",
            inputSchema={
                "type": "object",
                "properties": {
{% for param in tool.parameters %}
                    "{{ param.name }}": {
                        "type": "{{ param.type }}",
                        "description": "{{ param.description }}"{% if param.enum_values %},
                        "enum": {{ param.enum_values }}{% endif %}{% if param.default is not none %},
                        "default": {{ param.default }}{% endif %}
                    }{% if not loop.last %},{% endif %}
{% endfor %}
                },
                "required": [{% for param in tool.parameters %}{% if param.required %}"{{ param.name }}"{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}]
            }
        ){% if not loop.last %},{% endif %}
{% endfor %}
    ]


{% for tool in tools %}
async def {{ tool.name }}({% for param in tool.parameters %}{{ param.name }}: {% if param.type == "string" %}str{% elif param.type == "integer" %}int{% elif param.type == "number" %}float{% elif param.type == "boolean" %}bool{% elif param.type == "array" %}list{% elif param.type == "object" %}dict{% else %}Any{% endif %}{% if not param.required %} = {% if param.default is not none %}{{ param.default }}{% else %}None{% endif %}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}) -> {{ tool.return_type }}:
    """
    {{ tool.description }}

{% for param in tool.parameters %}
    Args:
        {{ param.name }}: {{ param.description }}
{% endfor %}

    Returns:
        {{ tool.return_description or "Result of the operation" }}
    """
    # TODO: Implement {{ tool.name }} logic
    logger.info(f"Executing {{ tool.name }}")

    # Placeholder implementation
    return {
        "status": "not_implemented",
        "message": "This tool handler needs to be implemented",
        "tool": "{{ tool.name }}"
    }


{% endfor %}

@app.call_tool()
async def call_tool(name: str, arguments: Any) -> list[TextContent]:
    """Handle tool execution requests."""
    logger.info(f"Tool called: {name} with arguments: {arguments}")

    try:
{% for tool in tools %}
        {% if loop.first %}if{% else %}elif{% endif %} name == "{{ tool.name }}":
            result = await {{ tool.name }}(
{% for param in tool.parameters %}
                {{ param.name }}=arguments.get("{{ param.name }}"{% if not param.required %}, {% if param.default is not none %}{{ param.default }}{% else %}None{% endif %}{% endif %}){% if not loop.last %},{% endif %}
{% endfor %}
            )
{% endfor %}
        else:
            raise ValueError(f"Unknown tool: {name}")

        return [TextContent(type="text", text=str(result))]

    except Exception as e:
        logger.error(f"Error executing tool {name}: {e}")
        return [TextContent(type="text", text=f"Error: {str(e)}")]


async def main():
    """Run the MCP server."""
    logger.info("Starting {{ server_name }} MCP server")

    async with stdio_server() as (read_stream, write_stream):
        await app.run(
            read_stream,
            write_stream,
            app.create_initialization_options()
        )


if __name__ == "__main__":
    asyncio.run(main())
